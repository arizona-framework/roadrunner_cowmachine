{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_export_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

%% Git refs until both land in a release: roadrunner's main with the
%% mechanisms this adapter uses, and cowmachine's pluggable server branch.
{deps, [
    {roadrunner,
        {git, "https://github.com/arizona-framework/roadrunner.git",
            {ref, "24f45e4449b868e849c27e0d631ce50e1070ce07"}}},
    {cowmachine,
        {git, "https://github.com/williamthome/cowmachine.git", {branch, "feat/pluggable-server"}}}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_hank, "2.0.2"},
    {rebar3_hex, "7.5.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.{erl,hrl,app.src}",
        "test/*.{erl,hrl}"
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.

{ct_opts, [{sys_config, ["config/test.config"]}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps},
    %% cowmachine's request map is Cowboy's (`cowboy_req:req()`), so the
    %% Cowboy types cowmachine brings along are part of this adapter's specs.
    {plt_extra_apps, [cowboy, cowlib, ranch, ssl, public_key]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hank, [
    {ignore, [
        %% cowmachine's own end-to-end tests, as its repository has them.
        "test/cowmachine_e2e_tests.erl",
        %% Cowboy WebSocket callbacks have fixed arities.
        {"test/roadrunner_cowmachine_ws_bare.erl", unnecessary_function_arguments}
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CONTRIBUTING.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, true},
    {source_url, "https://github.com/arizona-framework/roadrunner_cowmachine"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{alias, [
    {doc, [ex_doc]},
    {precommit, [
        {fmt, "--check"},
        compile,
        xref,
        hank,
        dialyzer,
        ex_doc,
        {eunit, "--cover"},
        {ct, "--cover"},
        {cover, "--verbose --min_coverage=100"}
    ]}
]}.
